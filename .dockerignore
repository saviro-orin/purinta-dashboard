# Keep the build context small and avoid leaking local/dev artifacts
# into the image. The build stage regenerates everything it needs.

# Bun/Node deps + build output
/node_modules/
/dist/
/data/

# VCS + CI + editor
/.git/
/.github/
.gitignore
.DS_Store

# Local env / secrets — never bake into an image
.env
.env.*

# Tests aren't needed for the production image
/test/

# The Dockerfile itself + compose files
Dockerfile
.dockerignore
docker-compose*.yml
